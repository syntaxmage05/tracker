<!-- app/views/standups/_standup.html.erb -->
<div id="<%= dom_id standup %>" class="block w-96 p-6 bg-white border border-gray-200 rounded-lg shadow-md">
  <div>
    <div class="float-right">
      <%= link_to edit_standup_path(standup) do %>
        <%= heroicon "pencil", class: 'inline' %>  <!-- Changed from pencil-alt -->
      <% end %>
    </div>
    <h3 class="text-xl font-bold leading-tight text-gray-900"><%= standup_header(standup) %></h3>
  </div>
  <% if standup.dids.any? %>
    <h4 class="mt-4 text-lg font-bold leading-tight text-gray-900">Dids</h4>
    <ul class="mt-2 space-y-2">
      <% standup.dids.each do |did| %>
        <li class="p-2 bg-gray-300 border border-gray-100 rounded shadow-sm"><%= did.title %></li>
      <% end %>
    </ul>
  <% end %>
  <% if standup.todos.any? %>
    <h4 class="mt-4 text-lg font-bold leading-tight text-gray-900">Todos</h4>
    <ul class="mt-2 space-y-2">
      <% standup.todos.each do |todo| %>
        <li class="p-2 bg-gray-300 border border-gray-100 rounded shadow-sm"><%= todo.title %></li>
      <% end %>
    </ul>
  <% end %>
  <% if standup.blockers.any? %>
    <h4 class="mt-4 text-lg font-bold leading-tight text-gray-900">Blockers</h4>
    <ul class="mt-2 space-y-2">
      <% standup.blockers.each do |blocker| %>
        <li class="p-2 bg-gray-300 border border-gray-100 rounded shadow-sm"><%= blocker.title %></li>
      <% end %>
    </ul>
  <% end %>
</div>