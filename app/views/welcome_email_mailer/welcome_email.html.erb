<div class="container py-5">
  <!-- Page Title -->
  <h1 class="text-center mb-5 display-4 fw-bold text-primary">
    Tracker App
  </h1>
  <!-- Welcome Card -->
  <div class="card shadow-lg border-0 rounded-4">
    <div class="card-body p-5">
      <!-- Welcome Header -->
      <h3 class="text-center mb-4 fw-semibold">
        Welcome <%= @user.name %>!
      </h3>
      <!-- Intro Paragraph -->
      <p class="mb-4 lead text-center">
        Thank you for signing up for <span class="fw-bold">Tracker App</span>!  
        We're excited to have you. Tracker App helps users track progress 
        collaboratively with team members easily and efficiently.
      </p>
      <!-- Image Section -->
      <div class="text-center mb-4">
        <%= image_tag attachments["standup.jpeg"].url, alt: "standup", class: "img-fluid rounded shadow-sm" %>
      </div>
      <!-- Call-to-Action Paragraph -->
      <p class="mb-4 text-center">
        The best way to get started is to invite more users 
        and set up your teams!
      </p>
      <!-- Button -->
      <div class="d-flex justify-content-center">
        <%= link_to "Add Users to Tracker App", account_users_url(), class: "btn btn-primary btn-lg px-5 rounded-pill" %>
      </div>
    </div>
  </div>
</div>