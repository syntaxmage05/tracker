<header>
  <!-- Nav -->
  <nav aria-label="menu nav" class="bg-gray-800 pt-2 md:pt-1 pb-1 px-2 mt-0 h-auto fixed w-full z-20 top-0">
    <div class="flex flex-wrap items-center">
      <!-- Logo / Home -->
      <div class="flex flex-shrink md:w-1/2 justify-center md:justify-start text-white">
        <a href="/" aria-label="Home">
          <span class="text-xl pl-2 font-semibold">Standup App</span>
        </a>
      </div>
      <!-- Navigation Links & Dropdowns -->
      <div class="flex w-full pt-2 content-center justify-between md:w-1/2 md:justify-end">
        <ul class="flex list-none justify-between flex-1 md:flex-none items-center">
          <!-- Main Links -->
          <li class="flex-1 md:flex-none md:mr-3">
            <a href="/t" class="inline-block py-2 px-4 text-white no-underline hover:text-gray-300">Teams</a>
            <a href="/s" class="inline-block py-2 px-4 text-white no-underline hover:text-gray-300">Standups</a>
          </li>
          <!-- Notification Dropdown -->
          <li class="flex-1 md:flex-none md:mr-3">
            <div data-controller="dropdown" class="relative inline-block">
              <button id="notification_dropdown" 
                      data-action="dropdown#toggle click@window->dropdown#hide"
                class="drop-button text-white py-2 px-2">
                <%= heroicon 'bell' %>
              </button>
              <%= turbo_stream_from current_user, "notification_standups" %>
              <div data-controller="dropdown" class="relative inline-block">
                <button id="notification_dropdown"
          data-action="dropdown#toggle click@window->dropdown#hide"
                  class="relative drop-button text-white py-2 px-2 focus:outline-none">
                  <%= heroicon 'bell' %>
                  <!-- Red badge for unread notifications -->
                  <span id="notification_count"
          class="absolute -top-1 -right-1 inline-flex items-center justify-center
                 px-2 py-0.5 text-xs font-bold leading-none text-white bg-red-600
                 rounded-full">
                    <%= notification_standups.count %>
                  </span>
                </button>
                <%= turbo_stream_from current_user, "notification_standups" %>
                <div data-dropdown-target="menu"
       class="hidden absolute right-0 mt-3 z-30">
                  <%= render partial: 'layouts/components/notifications',
               locals: { notification_standups: notification_standups } %>
                </div>
              </div>
            </div>
          </li>
          <!-- User Dropdown -->
          <li class="flex-1 md:flex-none md:mr-3">
            <div data-controller="dropdown" class="relative inline-block">
              <button data-action="dropdown#toggle click@window->dropdown#hide" 
                class="drop-button text-white py-2 px-2">
                <%= heroicon 'cog' %>
              </button>
              <div data-dropdown-target="menu"
                   id="nav-dropdown"
                   class="hidden absolute bg-gray-800 text-white right-0 mt-3 p-3 overflow-auto z-30"
                   data-transition-enter-from="opacity-0 scale-95"
                   data-transition-enter-to="opacity-100 scale-100"
                   data-transition-leave-from="opacity-100 scale-100"
                   data-transition-leave-to="opacity-0 scale-95">
                <img class="mx-auto rounded-full" 
                     alt="User Image" 
                     src='<%= user_avatar_url(current_user.email, 45) %>' />
                <span class="text-xs block text-center mt-1">
                  <%= current_user.email %>
                </span>
                <div class="py-4 border-t border-gray-300"></div>
                <a href="/user/me" data-action="dropdown#toggle" 
                   class="block p-2 hover:bg-gray-700 text-white text-md no-underline">
                  <i class="fa fa-user fa-fw"></i> Profile
                </a>
                <a href="/account/users" data-action="dropdown#toggle" 
                   class="block p-2 hover:bg-gray-700 text-white text-md no-underline">
                  <i class="fa fa-cog fa-fw"></i> Settings
                </a>
                <div class="py-2 border-t border-gray-300"></div>
                <%= link_to "Log out", destroy_user_session_path, method: :delete, class: "block p-2 hover:bg-gray-700 text-white text-md no-underline" %>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>