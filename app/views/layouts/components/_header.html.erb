<header>
  <!--Nav-->
  <nav aria-label="menu nav" class="fixed top-0 z-20 w-full h-auto px-1 pb-1 mt-0 bg-gray-800 pt-2 md:pt-1">
    <div class="flex flex-wrap items-center">
      <!-- Logo -->
      <div class="flex justify-center flex-shrink text-white md:w-1/3 md:justify-start">
        <a href="/" aria-label="Home">
          <span class="pl-2 text-xl">Standup App</span>
        </a>
      </div>
      <!-- Submit Standup Button -->
      <div class="flex justify-between w-full content-center md:w-1/3 md:justify-center">
        <ul class="flex items-center justify-between flex-1 list-reset md:flex-none">
          <li class="flex-1 md:flex-none md:mr-3">
            <a href='/s/new/<%= Date.today.iso8601 %>' 
               class="px-5 py-2.5 text-sm font-medium text-center text-gray-400 border border-gray-400 rounded-lg hover:text-white hover:bg-gray-600 focus:ring-gray-800 mr-2 mb-2">
              Submit a Standup
            </a>
          </li>
        </ul>
      </div>
      <!-- Right Menu -->
      <div class="flex justify-between w-full pt-2 content-center md:w-1/3 md:justify-end">
        <ul class="flex items-center justify-between flex-1 list-reset md:flex-none">
          <!-- Navigation Links -->
          <li class="flex-1 md:flex-none md:mr-3">
            <a href="/t" class="inline-block px-4 py-2 text-white no-underline">Teams</a>
            <a href="/s" class="inline-block px-4 py-2 text-white no-underline">Standups</a>
          </li>
          <!-- Notifications Dropdown -->
          <li class="flex-1 md:flex-none md:mr-3">
            <div data-controller="dropdown" class="relative inline-block">
              <button data-action="dropdown#toggle click@window->dropdown#hide" class="px-2 py-2 text-white drop-button">
                <%= heroicon 'bell' %>
              </button>
              <div data-dropdown-target="menu" 
                   class="absolute right-0 z-30 hidden w-64 p-3 mt-3 overflow-auto text-white bg-gray-800"
                   data-transition-enter-from="opacity-0 scale-95"
                   data-transition-enter-to="opacity-100 scale-100"
                   data-transition-leave-from="opacity-100 scale-100"
                   data-transition-leave-to="opacity-0 scale-95"
                   id="notifications-dropdown">
                <span class="text-xs text-gray-400">15 Notifications</span>
                <div class="border border-gray-800"></div>
                <a href="#" data-action="dropdown#toggle" class="block p-2 text-sm text-white no-underline hover:bg-gray-800 hover:no-underline">Some Notification</a>
                <a href="#" data-action="dropdown#toggle" class="block p-2 text-sm text-white no-underline hover:bg-gray-800 hover:no-underline">Another Notification</a>
              </div>
            </div>
          </li>
          <!-- User Menu Dropdown -->
          <li class="flex-1 md:flex-none md:mr-3">
            <div data-controller="dropdown" class="relative inline-block">
              <button data-action="dropdown#toggle click@window->dropdown#hide" class="px-2 py-2 text-white drop-button">
                <%= heroicon 'cog' %>
              </button>
              <div data-dropdown-target="menu" 
                   class="absolute right-0 z-30 hidden p-3 mt-3 overflow-auto text-white bg-gray-800"
                   data-transition-enter-from="opacity-0 scale-95"
                   data-transition-enter-to="opacity-100 scale-100"
                   data-transition-leave-from="opacity-100 scale-100"
                   data-transition-leave-to="opacity-0 scale-95"
                   id="user-dropdown">
                <img class="mx-auto rounded-full" 
                     alt="User Image" 
                     src='<%= user_avatar_url(current_user.email, 45) %>' />
                <span class="text-xs">
                  <%= current_user.email %>
                </span>
                <div class="py-4">
                  <div class="w-full border-t border-gray-300"></div>
                </div>
                <a href="/user/me" data-action="dropdown#toggle" class="block p-2 text-md text-white no-underline hover:bg-gray-800 hover:no-underline">
                  <i class="fa fa-user fa-fw"></i> Profile
                </a>
                <a href="/account/users" data-action="dropdown#toggle" class="block p-2 text-md text-white no-underline hover:bg-gray-800 hover:no-underline">
                  <i class="fa fa-cog fa-fw"></i> Settings
                </a>
                <div class="py-2">
                  <div class="w-full border-t border-gray-300"></div>
                </div>
                <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete}, 
                    class: 'block p-2 text-md text-white no-underline hover:bg-gray-800 hover:no-underline' %>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>